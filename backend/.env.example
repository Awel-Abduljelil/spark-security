PORT=3000
NODE_ENV=development
# Set to 1 when running behind a reverse proxy (Nginx, Caddy, Render, etc.)
TRUST_PROXY=0
# First-run admin account (only used when no admin exists yet).
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_EMAIL=admin@sparksecurity.local
ADMIN_PASSWORD=
# Set the same 32-character path in frontend/.env as VITE_ADMIN_PATH.
ADMIN_PATH=
# Where the database and private receipts live (back this folder up).
DATA_DIR=data
